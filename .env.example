# --- Database (free tier: neon.tech) ---
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth --- (any long random string; generate with: openssl rand -hex 32)
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Claude (the actual queue analysis) ---
# From console.anthropic.com -> API Keys. Pay-as-you-go, ~$0 while there
# are no paying businesses yet — see lib/plans.ts for the per-call math.
ANTHROPIC_API_KEY="sk-ant-..."

# --- Stripe (business billing only — customers never pay; set up when you're
# ready for real businesses, not needed for your own solo testing) ---
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_LINK_STARTER="https://buy.stripe.com/xxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_LINK_STANDARD="https://buy.stripe.com/xxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_LINK_PROFESSIONAL="https://buy.stripe.com/xxxxxxxxxxxx"

# --- Push notifications (free, no signup) ---
# Generate a fresh pair with: npx web-push generate-vapid-keys
# Paste the "Public Key" / "Private Key" it prints below. This talks
# directly to the browser vendor's own push service — no email, no
# per-message cost, no third-party account needed.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="..."
VAPID_PRIVATE_KEY="..."
VAPID_CONTACT_EMAIL="you@example.com"

# --- Cron security ---
# Any long random string. Whatever calls /api/cron/analyze (Vercel's own
# cron, or the free external pinger described in HANDOFF.md) sends this as
# a bearer token so no one else can trigger paid analysis calls.
CRON_SECRET="change-me-to-another-long-random-string"

# --- Public site URL ---
NEXT_PUBLIC_SITE_URL="https://quelens.com"
